      "kind": "pivot-table",
      "source": {
        "elementId": "tbl-tx",
        "kind": "table"
      },
      "columns": [
        {
          "id": "pv-dim",
          "formula": "If([DimensionPicker] = \"Store Region\", [Tx/Store Region], If([DimensionPicker] = \"Store Name\", [Tx/Store Name], If([DimensionPicker] = \"Product Type\", [Tx/Product Type], [Tx/Cust Name])))",
          "name": "Dimension"
        },
        {
          "id": "Qn0e0W1UEF",
          "formula": "DateTrunc(\"quarter\", [Date])",
          "name": "Quarterly Performance"
        },
        {
          "id": "pv-metric-val",
          "formula": "If([MetricPicker] = \"Revenue\", [Metrics/Total Revenue], If([MetricPicker] = \"Profit\", [Metrics/Total Profit], If([MetricPicker] = \"Margin\", [Metrics/Total Profit Margin] * 100, If([MetricPicker] = \"AOV\", [Metrics/AOV], [Metrics/Distinct Orders]))))",
          "name": "Value",
          "format": {
            "kind": "number",
            "formatString": ",.2f"
          }
        },
        {
          "id": "j0a2r5d982",
          "formula": "[Tx/Date]"
        }
