    {
      "id": "tbl-customer",
      "kind": "table",
      "source": {
        "dataModelId": "3889b3c3-4657-4d9e-b568-5d2388cf4b4c",
        "elementId": "UOWCvqPoXM",
        "kind": "data-model"
      },
      "columns": [
        {
          "id": "cu-cust-key",
          "formula": "[D_CUSTOMER/Cust Key]",
          "name": "Cust Key"
        },
        {
          "id": "cu-cust-name",
          "formula": "[D_CUSTOMER/Cust Name]",
          "name": "Cust Name"
        },
        {
          "id": "cu-cust-region",
          "formula": "[D_CUSTOMER/Cust Region]",
          "name": "Cust Region"
        },
        {
          "id": "cu-cust-state",
          "formula": "[D_CUSTOMER/Cust State]",
          "name": "Cust State"
        },
        {
          "id": "cu-age-group",
          "formula": "[D_CUSTOMER/Age Group]",
          "name": "Age Group"
        },
        {
          "id": "cu-cust-type",
          "formula": "[D_CUSTOMER/Cust Type]",
          "name": "Cust Type"
        },
        {
          "id": "cu-revenue",
          "formula": "Lookup(Sum([Tx/Sales Amount] * [Tx/Quantity]), [Cust Key], [Tx/Cust Key])",
          "name": "Customer Revenue",
          "format": {
            "kind": "number",
            "formatString": "$,.0f"
          }
        },
        {
          "id": "cu-orders",
          "formula": "Lookup(CountDistinct([Tx/Order Number]), [Cust Key], [Tx/Cust Key])",
          "name": "Customer Orders",
          "format": {
            "kind": "number",
            "formatString": ",.0f"
          }
        },
        {
          "id": "cu-aov",
          "formula": "If([Customer Orders] = 0, Null, [Customer Revenue] / [Customer Orders])",
          "name": "Customer AOV",
          "format": {
            "kind": "number",
            "formatString": "$,.2f"
          }
        },
        {
          "id": "cu-aov-bucket",
          "formula": "If(IsNull([Customer AOV]), \"No Orders\", [Customer AOV] < 50, \"Under $50\", [Customer AOV] < 150, \"$50-150\", [Customer AOV] < 400, \"$150-400\", \"$400+\")",
          "name": "AOV Bucket"
        }
      ],
      "name": "Customer",
      "order": [
        "cu-cust-key",
        "cu-cust-name",
        "cu-cust-region",
        "cu-cust-state",
        "cu-age-group",
        "cu-cust-type",
